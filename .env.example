# Environment template — names and fictional values only; never real secrets.
# The app validates these at startup; see docs/adr/0002-arquitectura-base.md.

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (local dev via docker compose; managed on the VPS in staging/prod)
DATABASE_URL=postgres://gym:gym-local-dev@localhost:5432/gym
DATABASE_SSL=false

# Better Auth (self-hosted in Fastify)
# Generate a real value out-of-band: openssl rand -base64 32 (>=32 chars)
AUTH_SECRET=replace-with-generated-secret-out-of-band
AUTH_URL=http://localhost:3000
SESSION_TTL_HOURS=12

# CSRF allow-list for /api/auth/* — browser origins allowed to authenticate.
# Dev: the Vite SPA on :5173 proxies /api/* to the API, so its origin must be
# trusted. Prod: set to the public app origin (comma-separated, no spaces).
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# CORS / frontend origin (web SPA)
WEB_ORIGIN=http://localhost:5173

# Offline mode (G1-OFF): parameters still HITO0_PENDING — values below are
# working assumptions for local development, NOT approved policy.
OFFLINE_ENABLED=false
OFFLINE_GRANT_TTL_HOURS=72

# Email delivery adapter (SPEC 021)
# Modes: disabled (default for dev/CI) | http | webhook
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM=notificaciones@gimnasio.cl
EMAIL_TRANSPORT_URL=http://localhost:8025/api/v1/send
EMAIL_WEBHOOK_URL=http://localhost:8025/webhook

